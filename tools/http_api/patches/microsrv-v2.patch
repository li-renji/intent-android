+/* ---------------- HTTP 小工具 ---------------- */
+
+static void send_all(int fd, const char *data, size_t len) {
+    size_t off = 0;
+    while (off < len) {
+        ssize_t w = send(fd, data + off, len - off, MSG_NOSIGNAL);
+        if (w <= 0) {
+            if (w < 0 && errno == EINTR) continue;
+            break;
+        }
+        off += (size_t)w;
+    }
+}
+
+static void http_reply(int fd, int code, const char *reason, const char *ctype,
+                       const char *body, size_t body_len) {
+    char head[512];
+    int n = snprintf(head, sizeof(head),
+                     "HTTP/1.1 %d %s\r\n"
+                     "Content-Type: %s\r\n"
+                     "Content-Length: %zu\r\n"
+                     "Access-Control-Allow-Origin: *\r\n"
+                     "Access-Control-Allow-Methods: GET, POST, OPTIONS\r\n"
+                     "Access-Control-Allow-Headers: Content-Type\r\n"
+                     "Connection: close\r\n"
+                     "\r\n",
+                     code, reason, ctype, body_len);
+    if (n > 0) send_all(fd, head, (size_t)n);
+    if (body && body_len) send_all(fd, body, body_len);
+}
+
+static void http_json(int fd, int code, const char *reason, const char *json) {
+    http_reply(fd, code, reason, "application/json; charset=utf-8", json, strlen(json));
+}
