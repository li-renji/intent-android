+/* 从 body 里取 prompt：支持纯文本，也支持 {"prompt":"..."} */
+static const char *extract_prompt(const char *body, size_t len, char *out, size_t cap) {
+    size_t i = 0;
+    while (i < len && (body[i] == ' ' || body[i] == '\r' || body[i] == '\n' || body[i] == '\t')) i++;
+
+    if (i < len && body[i] == '{') {
+        const char *key = strstr(body + i, "\"prompt\"");
+        if (key) {
+            const char *p = strchr(key + 8, ':');
+            if (p) {
+                p++;
+                while (*p == ' ' || *p == '\t') p++;
+                if (*p == '"') {
+                    p++;
+                    size_t o = 0;
+                    while (*p && *p != '"' && o + 1 < cap) {
+                        if (*p == '\\' && p[1]) {
+                            p++;
+                            switch (*p) {
+                                case 'n': out[o++] = '\n'; break;
+                                case 't': out[o++] = '\t'; break;
+                                case 'r': out[o++] = '\r'; break;
+                                default:  out[o++] = *p;  break;
+                            }
+                            p++;
+                        } else {
+                            out[o++] = *p++;
+                        }
+                    }
+                    out[o] = '\0';
+                    return out;
+                }
+            }
+        }
+        return NULL; /* 是 JSON 但没有 prompt 字段 */
+    }
+
+    size_t n = len < cap - 1 ? len : cap - 1;
+    memcpy(out, body, n);
+    out[n] = '\0';
+    while (n > 0 && (out[n-1] == '\n' || out[n-1] == '\r' || out[n-1] == ' ')) out[--n] = '\0';
+    return out;
+}
