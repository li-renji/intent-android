+/* ---------------- 客户端状态机 ---------------- */
+
+typedef struct {
+    int    fd;
+    int    used;
+    int    waiting_ai;    /* 1 = 已投递 api_request，等 app.js 回写 */
+    time_t deadline;
+    char   req[REQ_CAP];
+    size_t req_len;
+} Client;
+
+static Client g_clients[MAX_CLIENTS];
+
+static void client_close(Client *c) {
+    if (!c->used) return;
+    close(c->fd);
+    c->used = 0;
+    c->fd = -1;
+    c->req_len = 0;
+    c->waiting_ai = 0;
+}
+
+static Client *client_alloc(void) {
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        if (!g_clients[i].used) {
+            g_clients[i].used = 1;
+            g_clients[i].fd = -1;
+            g_clients[i].req_len = 0;
+            g_clients[i].waiting_ai = 0;
+            return &g_clients[i];
+        }
+    }
+    return NULL;
+}
+
+static int any_waiting_ai(void) {
+    for (int i = 0; i < MAX_CLIENTS; i++)
+        if (g_clients[i].used && g_clients[i].waiting_ai) return 1;
+    return 0;
+}
