+/* 解析并处理一条请求 */
+static int handle_http_request(Client *c) {
+    char *buf = c->req;
+    size_t len = c->req_len;
+
+    char *hdr_end = strstr(buf, "\r\n\r\n");
+    if (!hdr_end) return HR_NEED_MORE;
+    size_t hdr_len = (size_t)(hdr_end - buf) + 4;
+
+    char method[16] = {0}, path[256] = {0};
+    if (sscanf(buf, "%15s %255s", method, path) != 2) {
+        http_json(c->fd, 400, "Bad Request", "{\"error\":\"bad request line\"}");
+        return HR_DONE;
+    }
+    char *qmark = strchr(path, '?');
+    if (qmark) *qmark = '\0';
+
+    size_t clen = 0;
+    for (char *p = buf; p < hdr_end; p++) {
+        if (strncasecmp(p, "Content-Length:", 15) == 0) {
+            clen = (size_t)strtoul(p + 15, NULL, 10);
+            break;
+        }
+    }
+    if (hdr_len + clen > len) return HR_NEED_MORE;   /* body 还没收全 */
+
+    printf("microsrv: %s %s (%zu B body)\n", method, path, clen);
+    fflush(stdout);
+
+    if (strcmp(method, "OPTIONS") == 0) {
+        http_reply(c->fd, 204, "No Content", "text/plain", "", 0);
+        return HR_DONE;
+    }
+
+    if (strcmp(method, "GET") == 0 && strcmp(path, "/health") == 0) {
+        char json[700];
+        build_health_json(json, sizeof(json));
+        http_json(c->fd, 200, "OK", json);
+        return HR_DONE;
+    }
+
+    if (strcmp(method, "GET") == 0 && strcmp(path, "/") == 0) {
+        char text[700];
+        snprintf(text, sizeof(text),
+                 "奇点OS mini 微服务 v%s\n"
+                 "pid=%d  运行=%lds  内存≈%ldKB  心跳=%ld\n"
+                 "HTTP :%d   状态 :%d   AI 桥接目录=%s\n"
+                 "接口: GET /health, POST /chat\n",
+                 VERSION, (int)getpid(), (long)(time(NULL) - g_start),
+                 read_rss_kb(), g_heartbeat, g_http_port, g_status_port, g_api_dir);
+        http_reply(c->fd, 200, "OK", "text/plain; charset=utf-8", text, strlen(text));
+        return HR_DONE;
+    }
+
+    if (strcmp(path, "/chat") == 0) {
+        if (strcmp(method, "POST") != 0) {
+            http_json(c->fd, 405, "Method Not Allowed",
+                      "{\"error\":\"use POST /chat with the prompt as body\"}");
+            return HR_DONE;
+        }
+        if (any_waiting_ai()) {
+            http_json(c->fd, 429, "Too Many Requests",
+                      "{\"error\":\"AI busy, one request at a time\"}");
+            return HR_DONE;
+        }
+
+        char prompt[4096];
+        const char *p = extract_prompt(buf + hdr_len, clen, prompt, sizeof(prompt));
+        if (!p || prompt[0] == '\0') {
+            http_json(c->fd, 400, "Bad Request", "{\"error\":\"empty prompt\"}");
+            return HR_DONE;
+        }
+
+        char req[300], resp[300];
+        api_path(req, sizeof(req), "api_request");
+        api_path(resp, sizeof(resp), "api_response");
+
+        FILE *f = fopen(req, "wb");
+        if (!f) {
+            http_json(c->fd, 500, "Internal Server Error", "{\"error\":\"cannot write api_request\"}");
+            return HR_DONE;
+        }
+        fwrite(prompt, 1, strlen(prompt), f);
+        fclose(f);
+        unlink(resp);                    /* 清掉上一轮的残留 */
+
+        c->waiting_ai = 1;
+        c->deadline = time(NULL) + g_ai_timeout;
+        printf("microsrv: /chat 已投递 (%.40s) 等待桥接\n", prompt);
+        fflush(stdout);
+        return HR_WAITING;
+    }
+
+    http_json(c->fd, 404, "Not Found", "{\"error\":\"not found\"}");
+    return HR_DONE;
+}
