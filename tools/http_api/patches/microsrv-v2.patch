+/* 每轮检查等待中的客户端：api_response 到了就转发，超时就 504 */
+static void poll_ai_responses(void) {
+    for (int i = 0; i < MAX_CLIENTS; i++) {
+        Client *c = &g_clients[i];
+        if (!c->used || !c->waiting_ai) continue;
+
+        char resp[300];
+        api_path(resp, sizeof(resp), "api_response");
+
+        if (file_exists(resp)) {
+            char *body = malloc(RESP_CAP);
+            long n = body ? read_file(resp, body, RESP_CAP) : -1;
+            unlink(resp);
+            if (n > 0) {
+                http_reply(c->fd, 200, "OK", "application/json; charset=utf-8", body, (size_t)n);
+                g_chat_ok++;
+                printf("microsrv: /chat 完成 %ld B\n", n);
+            } else {
+                http_json(c->fd, 500, "Internal Server Error", "{\"error\":\"empty api_response\"}");
+                g_chat_fail++;
+            }
+            free(body);
+            client_close(c);
+            fflush(stdout);
+            continue;
+        }
+
+        if (time(NULL) >= c->deadline) {
+            http_json(c->fd, 504, "Gateway Timeout",
+                      "{\"error\":\"AI timeout\",\"hint\":\"app.js bridge not running? check /tmp/bridge_debug.log\"}");
+            g_chat_fail++;
+            printf("microsrv: /chat 超时\n");
+            fflush(stdout);
+            client_close(c);
+        }
+    }
+}
